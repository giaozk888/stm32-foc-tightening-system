# Default deny: credentials, private backups, databases and captures never enter the image.
**
!Dockerfile
!.clang-format
!firmware_common/
!firmware_common/**
!foc2_app_a/
!foc2_app_a/**
!foc2_app_b/
!foc2_app_b/**
!third_party/
!third_party/**
!tests/
!tests/**
!router_network/
!router_network/**
!tools/
!tools/docker_build.py
!tools/format_code.py
!tools/format_scope.txt
**/.git/**
**/__pycache__/**
**/build*/**
**/out/**
**/*.bin
**/*.elf
**/*.hex
**/*.log
**/*.sr
**/*.sqlite*
**/*.zip
**/*.7z
**/*.tar*
**/*backup*/**
**/local_config/**
**/safety_backups/**
**/*private*/**
**/.ssh/**
**/.aws/**
**/.env*
**/*.pem
**/*.key
**/authorized_keys*
**/.pw_env/**
**/.environment/**
