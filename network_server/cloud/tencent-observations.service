[Unit]
Description=Read-only tightening cloud observation backend
After=network.target

[Service]
Type=simple
User=tightening
Group=tightening
WorkingDirectory=/opt/tightening-observations
EnvironmentFile=/etc/tightening-observations.env
ExecStart=/usr/bin/python3 -m network_server.server --bind 127.0.0.1 --port 18088 --db /var/lib/tightening-observations/observations.sqlite3
StateDirectory=tightening-observations
StateDirectoryMode=0700
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tightening-observations

[Install]
WantedBy=multi-user.target
